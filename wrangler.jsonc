// Cloudflare Workers config for the online server and the site.
// `npm run server` runs it locally; `npm run deploy` publishes it.
// See "Online server" in docs/MULTIPLAYER.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router owns every other path, so unknown paths get index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchRoom" },
      // One object holds every account, rating and finished online game (worker/accounts.ts).
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      // One object runs matchmaking (worker/lobbyRoom.ts).
      { "name": "LOBBY", "class_name": "LobbyRoom" },
    ],
  },
  // SQLite-backed Durable Objects are the kind the free plan includes. Each
  // new class needs a new migration tag; a deployed tag is never edited.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts", "LobbyRoom"] },
  ],
  // A per-minute filter in front of the routes worker/rateLimit.ts limits. The
  // exact limits (per hour, per 15 minutes) are counted in the Accounts store,
  // so the site works the same if this binding is removed.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true },
  // The weekly accounts export to R2 (worker/backupExport.ts), off until the
  // owner creates the bucket. To turn it on: `npx wrangler r2 bucket create
  // open-dam-backups`, uncomment both blocks below, and deploy. Steps and
  // checks are in docs/OPERATIONS.md, "Weekly export".
  // "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "open-dam-backups" }],
  // "triggers": { "crons": ["0 3 * * 1"] },
}
